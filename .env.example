# OmniRoute
# Copy to .env and change before production.

# Server
PORT=20128
OMNIROUTE_DATA_DIR=./data

# AES-256-GCM secret for provider keys. Use a long random string.
OMNIROUTE_MASTER_KEY=change-me-to-a-64-char-random-secret

# Catalog metadata size advertised by the dashboard.
# Use 352 for the full marketing catalog in hosted demos.
OMNIROUTE_CATALOG_SIZE=60

# CLI/dashboard base URL
OMNIROUTE_BASE_URL=http://localhost:20128
